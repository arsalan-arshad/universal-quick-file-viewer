<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Grants access to Universal Quick File Viewer Apex controllers and invocable actions.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Universal Quick File Viewer User</label>
    <classAccesses>
        <apexClass>FileViewerService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FileViewerController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FileViewerInvocable</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
